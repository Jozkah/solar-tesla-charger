# ===========================================================================
# Pick ONE Tesla backend (config.json -> tesla.backend, default "teslamateapi")
# ===========================================================================

# --- Backend A: TeslaMateApi (recommended) --------------------------------
# Reuses TeslaMate's tokens + command host. Run tobiasehlert/teslamateapi with
# ENABLE_COMMANDS=true, COMMANDS_CHARGING=true, and an API_TOKEN (>=32 chars).
TESLAMATEAPI_BASE_URL=http://localhost:8080
TESLAMATEAPI_CAR_ID=1
TESLAMATEAPI_TOKEN=

# --- Backend B: official Fleet API + tesla-http-proxy ---------------------
# Only needed if tesla.backend = "proxy" in config.json.
# TESLA_BACKEND=proxy
# TESLA_REFRESH_TOKEN=
# TESLA_CLIENT_ID=
# TESLA_FLEET_BASE=https://fleet-api.prd.eu.vn.cloud.tesla.com
# TESLA_TOKEN_URL=https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token
# TESLA_VIN=
# TESLA_PROXY_BASE_URL=https://localhost:4443

# ===========================================================================
# SolaX Cloud (second solar array generation)
# Get tokenId from solaxcloud.com -> Service -> API. wifiSn is the dongle
# registration number shown in SolaXCloud under the device.
# ===========================================================================
SOLAX_API_URL=https://global.solaxcloud.com
SOLAX_TOKEN_ID=
SOLAX_WIFI_SN=

# ===========================================================================
# Shelly Cloud (optional, for historical backfill)
# Auth key + server are shown in the Shelly app under Authorization cloud key.
# ===========================================================================
SHELLY_CLOUD_AUTH_KEY=
SHELLY_CLOUD_SERVER=
SHELLY_CLOUD_DEVICE_10=
SHELLY_CLOUD_DEVICE_11=
