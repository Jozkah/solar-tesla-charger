# ===========================================================================
# Pick ONE Tesla backend (config.json -> tesla.backend, default "teslamateapi")
# ===========================================================================

# --- Backend A: TeslaMateApi (recommended) --------------------------------
# Reuses TeslaMate's tokens + command host. Run tobiasehlert/teslamateapi with
# ENABLE_COMMANDS=true, COMMANDS_CHARGING=true, and an API_TOKEN (>=32 chars).
TESLAMATEAPI_BASE_URL=http://localhost:8080
TESLAMATEAPI_CAR_ID=1
TESLAMATEAPI_TOKEN=

# --- Backend B: official Fleet API + OAuth third-party tokens -------------
# Set tesla.backend = "proxy" in config.json to use this path.
# Create a Tesla developer app, then:
#   1) set these, 2) open /api/tesla/login to authorize, 3) run tesla-http-proxy
#      (commands must be signed via the Vehicle Command Protocol).
# TESLA_BACKEND=proxy
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_VIN=
# Must exactly match a redirect URI registered on your Tesla developer app:
TESLA_REDIRECT_URI=http://localhost:3000/api/tesla/callback
# Region base (EU/NA/CN). Used as the OAuth audience and the Fleet API host.
TESLA_FLEET_BASE=https://fleet-api.prd.eu.vn.cloud.tesla.com
# Local signed-command proxy (tesla-http-proxy):
TESLA_PROXY_BASE_URL=https://localhost:4443
# Advanced (defaults are fine):
# TESLA_AUTHORIZE_URL=https://auth.tesla.com/oauth2/v3/authorize
# TESLA_TOKEN_URL=https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token
# TESLA_SCOPES=openid offline_access vehicle_device_data vehicle_cmds vehicle_charging_cmds

# ===========================================================================
# SolaX Cloud (second solar array generation)
# Get tokenId from solaxcloud.com -> Service -> API. wifiSn is the dongle
# registration number shown in SolaXCloud under the device.
# ===========================================================================
SOLAX_API_URL=https://global.solaxcloud.com
SOLAX_TOKEN_ID=
SOLAX_WIFI_SN=

# ===========================================================================
# Weather forecast location (Open-Meteo, no API key). These are your home
# coordinates, kept OUT of config.json so they're never committed. The car's
# live GPS location is used when these are unset.
# ===========================================================================
WEATHER_LAT=
WEATHER_LON=

# ===========================================================================
# Shelly Cloud (optional, for historical backfill)
# Auth key + server are shown in the Shelly app under Authorization cloud key.
# ===========================================================================
SHELLY_CLOUD_AUTH_KEY=
SHELLY_CLOUD_SERVER=
SHELLY_CLOUD_DEVICE_10=
SHELLY_CLOUD_DEVICE_11=

# ===========================================================================
# Push notifications (charging start/stop). Pick ONE channel.
# ===========================================================================
# ntfy (recommended): install the ntfy app, subscribe to this topic.
# Use a long, private, random topic name (it's effectively the password).
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh          # or your self-hosted ntfy
# NTFY_TOKEN=                          # only if your topic is access-protected
# Pushover:
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
# Telegram:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ===========================================================================
# Home dashboard — Agent DVR cameras (/home page)
# Camera host + (optional) login. Camera oids and the smart-plug IPs live in
# config.json (cameras.list / kasa.plugs) since they aren't secret. Set these
# only if your Agent DVR requires a login (Server Settings -> Users).
# ===========================================================================
# CAMERAS_HOST=http://localhost:8090
# CAMERAS_USER=
# CAMERAS_PASS=

# ===========================================================================
# Home dashboard — TP-Link Tapo smart plugs (P100/P110/P115)
# Tapo plugs use the local KLAP handshake, which needs your TP-Link (Tapo)
# account email + password. Used locally only (not a cloud round-trip). Set a
# plug's "protocol": "tapo" and its IP in config.json (kasa.plugs). Legacy Kasa
# plugs (HS/KP) don't need this.
# ===========================================================================
TAPO_EMAIL=
TAPO_PASSWORD=
